# Copy to .env for local development. Never commit the real values.

# PostgreSQL connection string (Neon, Supabase, or a local database).
DATABASE_URL=postgres://user:password@localhost:5432/cafe_pos

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Port the server listens on. Render sets this automatically.
PORT=8080

# Optional: HTTPS endpoint that receives order.completed events (n8n, Zapier).
# ORDER_COMPLETED_WEBHOOK_URL=https://example.com/webhook

# Optional: folder holding the built web app. Defaults to artifacts/cafe-pos/dist/public.
# STATIC_DIR=
